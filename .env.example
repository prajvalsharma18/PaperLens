# OpenAI — used for embeddings (text-embedding-3-small), vision (gpt-4o-mini), and generation (gpt-4o)
OPENAI_API_KEY="your-openai-api-key-here"

# Qdrant vector store
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""              # Required for Qdrant Cloud; leave blank for local

# Collection and storage config
COLLECTION_NAME="rag_documents"
DOC_STORE_PATH="./doc_store"   # Local path for raw image/table storage

# Model overrides (optional)
LLM_MODEL="gpt-4o"             # Generation model
EMBED_MODEL="text-embedding-3-small"
VISION_MODEL="gpt-4o-mini"     # Chart summarisation model
